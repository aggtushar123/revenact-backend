# Copy this file to .env and adjust as needed. .env is gitignored.

# Django
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://revenact:revenact@localhost:5432/revenact

# CORS — origins the frontend is served from
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (forgot/reset password) — leave both blank to fall back to the
# console backend (reset emails print to this terminal instead of sending).
# For Gmail SMTP: enable 2FA on the account, then create an App Password at
# https://myaccount.google.com/apppasswords and use that here, NOT your
# normal Gmail password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# DEFAULT_FROM_EMAIL=

# Frontend origin the emailed reset link points at
FRONTEND_URL=http://localhost:5173

# Copilot (Anthropic Claude) — leave blank to have Copilot respond with a
# clear "not configured" error instead of a fake answer. Get a key at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
